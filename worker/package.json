{
  "name": "demoview-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "oxlint",
    "types": "wrangler types --include-runtime=false --strict-vars=false --env-file .dev.vars.example",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:dev": "npm run build:web && wrangler deploy --env=\"\"",
    "deploy:prod": "npm run build:web && wrangler deploy --env prod",
    "pulse:golden": "esbuild scripts/pulse-golden.ts --bundle --platform=node --format=esm --outfile=.pulse/golden.mjs --log-level=warning && node .pulse/golden.mjs",
    "pulse:eval": "esbuild scripts/pulse-eval.ts --bundle --platform=node --format=esm --outfile=.pulse/eval.mjs --log-level=warning && node .pulse/eval.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "esbuild": "^0.28.1",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.146.0"
  }
}
