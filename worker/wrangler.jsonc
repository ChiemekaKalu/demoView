// The top level is the dev environment, so `wrangler dev` and a bare
// `wrangler deploy` never touch prod. Prod is `wrangler deploy --env prod`.
// Bindings, vars and containers are not inherited by environments, so prod
// repeats them.
//
// The parser runs as a Cloudflare Container (src/container.ts). wrangler
// deploy builds its image from parser/Dockerfile, which needs Docker, so
// deploys run in CI (.github/workflows/deploy.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demoview-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true }
  },
  // The viewer, served by this same Worker so the API needs no CORS. Build
  // it first (`npm run build:web`). Requests for /api/* always reach the
  // Worker; any other path that isn't a file gets index.html, so the
  // viewer's client-side routes (/m/:id, /m/:id/r/:n) load directly.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // PARSER_BUILD names the parser's code, so the reparse cron can find matches
  // parsed by older code. CI sets it at deploy (--var), from the git trees of
  // parser/ and tools/oracle/.
  "vars": {
    "R2_ACCOUNT_ID": "b6393ca49ee619a394bda6c2ea969bfc",
    "R2_BUCKET": "demoview-dev",
    "PARSER_BUILD": "dev"
  },
  // basic is 1/4 vCPU and 1 GiB: a parse of the largest fixture peaks near
  // 450 MB with round files at 64 Hz.
  "containers": [
    {
      "class_name": "ParserContainer",
      "image": "../parser/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PARSER", "class_name": "ParserContainer" }]
  },
  "exports": {
    "ParserContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  // wrangler dev would need Docker to run the container; without it, parses
  // fail and retry. Set to true with Docker running to parse locally.
  "dev": { "enable_containers": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demoview-dev",
      "database_id": "046adf1e-1124-484e-b9de-24cb974621d4"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "demoview-dev" }],
  // A message is delivered once plus max_retries times before it moves to the
  // dead letter queue, so max_retries 2 gives the spec's 3 attempts
  // (MAX_ATTEMPTS in src/consumer.ts). One job at a time, since every parse
  // shares the one container. The Worker also consumes the DLQ to mark
  // matches failed.
  "queues": {
    "producers": [{ "binding": "PARSE_QUEUE", "queue": "demoview-dev-parse" }],
    "consumers": [
      {
        "queue": "demoview-dev-parse",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 2,
        "retry_delay": 30,
        "dead_letter_queue": "demoview-dev-parse-dlq"
      },
      { "queue": "demoview-dev-parse-dlq" }
    ]
  },
  // The stuck-match sweeper, the hourly reparse batch and the daily cleanup
  // (src/cron.ts, whose cron strings must match these).
  "triggers": { "crons": ["*/10 * * * *", "0 * * * *", "30 4 * * *"] },
  "env": {
    "prod": {
      "name": "demoview-api",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": false,
        "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
        "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
        "issues": { "enabled": true }
      },
      "vars": {
        "R2_ACCOUNT_ID": "b6393ca49ee619a394bda6c2ea969bfc",
        "R2_BUCKET": "demoview-prod",
        "PARSER_BUILD": "dev"
      },
      // basic is 1/4 vCPU and 1 GiB: a parse of the largest fixture peaks near
      // 450 MB with round files at 64 Hz.
      "containers": [
        {
          "class_name": "ParserContainer",
          "image": "../parser/Dockerfile",
          "image_build_context": "..",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "PARSER", "class_name": "ParserContainer" }]
      },
      "exports": {
        "ParserContainer": { "type": "durable-object", "storage": "sqlite" }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "demoview-prod",
          "database_id": "65265646-d943-4ab9-94ed-6204619b8d6a"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "demoview-prod" }],
      "queues": {
        "producers": [{ "binding": "PARSE_QUEUE", "queue": "demoview-prod-parse" }],
        "consumers": [
          {
            "queue": "demoview-prod-parse",
            "max_batch_size": 1,
            "max_concurrency": 1,
            "max_retries": 2,
            "retry_delay": 30,
            "dead_letter_queue": "demoview-prod-parse-dlq"
          },
          { "queue": "demoview-prod-parse-dlq" }
        ]
      },
      // Off until the reparse exit checks pass on dev.
      "triggers": { "crons": [] }
    }
  }
}
