// The top level is the dev environment, so `wrangler dev` and a bare
// `wrangler deploy` never touch prod. Prod is `wrangler deploy --env prod`.
// Bindings and vars are not inherited by environments, so prod repeats them.
//
// Placeholders to fill in before the first deploy (see README.md):
//   database_id   from `wrangler d1 create`
//   R2_ACCOUNT_ID the Cloudflare account id
//   PARSER_URL    the Cloud Run service URL
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demoview-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "PARSER_URL": "https://demoview-parser-dev.example.run.app",
    "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "R2_BUCKET": "demoview-dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demoview-dev",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "demoview-dev" }],
  // A message is delivered once plus max_retries times before it moves to the
  // dead letter queue, so max_retries 2 gives the spec's 3 attempts
  // (MAX_ATTEMPTS in src/consumer.ts). One job per batch, since a parse can
  // take minutes. The Worker also consumes the DLQ to mark matches failed.
  "queues": {
    "producers": [{ "binding": "PARSE_QUEUE", "queue": "demoview-dev-parse" }],
    "consumers": [
      {
        "queue": "demoview-dev-parse",
        "max_batch_size": 1,
        "max_retries": 2,
        "retry_delay": 30,
        "dead_letter_queue": "demoview-dev-parse-dlq"
      },
      { "queue": "demoview-dev-parse-dlq" }
    ]
  },
  "env": {
    "prod": {
      "name": "demoview-api",
      "vars": {
        "PARSER_URL": "https://demoview-parser.example.run.app",
        "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
        "R2_BUCKET": "demoview-prod"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "demoview-prod",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "demoview-prod" }],
      "queues": {
        "producers": [{ "binding": "PARSE_QUEUE", "queue": "demoview-prod-parse" }],
        "consumers": [
          {
            "queue": "demoview-prod-parse",
            "max_batch_size": 1,
            "max_retries": 2,
            "retry_delay": 30,
            "dead_letter_queue": "demoview-prod-parse-dlq"
          },
          { "queue": "demoview-prod-parse-dlq" }
        ]
      }
    }
  }
}
