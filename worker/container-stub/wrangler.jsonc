// A throwaway Worker that answers one question before the parser moves to
// Cloudflare Containers: can a queue consumer hold one request to a
// container open for several minutes? See src/index.ts. Delete this
// directory, the Worker and the queue once that is settled.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "demoview-container-stub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "StubContainer",
      "image": "docker.io/library/python:3.13-alpine",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "STUB_CONTAINER", "class_name": "StubContainer" }]
  },
  "exports": {
    "StubContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "queues": {
    "producers": [{ "binding": "STUB_QUEUE", "queue": "demoview-stub-test" }],
    "consumers": [{ "queue": "demoview-stub-test", "max_batch_size": 1, "max_retries": 0 }]
  }
}
